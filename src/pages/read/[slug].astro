---
import Layout from '../../layouts/Layout.astro';
import AdSlot from '../../components/AdSlot.astro';
import CardMedia from '../../components/CardMedia.astro';
import { getAllPosts, getPostBySlug, formatViews } from '../../lib/models';

const { slug } = Astro.params;
const allPosts = await getAllPosts(Astro.locals);
const post = (slug ? await getPostBySlug(slug, Astro.locals) : null) || allPosts.find((p) => p.post_type === 'article') || allPosts[0];
const relatedArticles = allPosts.filter((p) => p.id !== post.id);

// JSON-LD Structured Data for NewsArticle (FR-04)
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "NewsArticle",
  "headline": post.title,
  "description": post.excerpt,
  "image": [post.thumbnail_url],
  "datePublished": post.published_at,
  "author": [{
    "@type": "Person",
    "name": post.author_name || "Editorial Staff"
  }]
};
---

<Layout title={post.title} description={post.excerpt} currentCategory={post.category_slug}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <article class="grid grid-cols-1 lg:grid-cols-12 gap-8">
    <!-- Main Editorial Article Content (8 cols) -->
    <div class="lg:col-span-8 flex flex-col">
      <!-- Breadcrumb -->
      <div class="flex items-center gap-2 text-xs text-zinc-400 mb-3">
        <a href="/" class="hover:text-white">Home</a>
        <span>/</span>
        <a href={`/category/${post.category_slug}`} class="text-red-400 uppercase font-semibold">
          {post.category_name}
        </a>
      </div>

      <h1 class="text-2xl sm:text-4xl font-extrabold text-white leading-tight mb-4">
        {post.title}
      </h1>

      <p class="text-sm sm:text-base text-zinc-300 font-medium leading-relaxed mb-6">
        {post.excerpt}
      </p>

      <!-- Author and Metadata Bar -->
      <div class="flex items-center justify-between py-3 border-y border-zinc-800 mb-6">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-full bg-zinc-800 border border-zinc-700 flex items-center justify-center font-bold text-sm text-red-500">
            {post.author_name?.[0] || 'A'}
          </div>
          <div>
            <div class="text-sm font-semibold text-white">{post.author_name}</div>
            <div class="text-xs text-zinc-500">
              Published on {new Date(post.published_at).toLocaleDateString()} • {formatViews(post.views_count)} views
            </div>
          </div>
        </div>

        <div class="flex items-center gap-2">
          <button class="px-3 py-1.5 rounded-lg bg-zinc-800 hover:bg-zinc-700 text-xs text-zinc-300 font-semibold transition">
            Share
          </button>
        </div>
      </div>

      <!-- Featured Image Cover -->
      <div class="relative w-full aspect-video rounded-2xl overflow-hidden bg-zinc-900 mb-8 border border-zinc-800">
        <img
          src={post.thumbnail_url}
          alt={post.title}
          class="w-full h-full object-cover"
        />
      </div>

      <!-- Body Copy with Programmatic In-Article Ad Placements -->
      <div class="prose prose-invert max-w-none text-zinc-300 leading-relaxed space-y-4">
        {post.content_html ? (
          <div set:html={post.content_html} />
        ) : (
          <p>{post.excerpt}</p>
        )}

        <!-- Mid-Article In-Content Ad (Paragraph 2/3 break) -->
        <div class="my-8">
          <AdSlot slotKey="in_article_mid" minHeight="250px" />
        </div>

        <p class="text-zinc-400">
          The acceleration of edge compute technologies coupled with lightweight static rendering delivers unprecedented throughput for modern media entities. Reader dwell time and interaction rates continue to scale as page load latency decreases below modern web expectations.
        </p>

        <!-- Outstream Video Player Placeholder Hook -->
        <div class="my-6 p-4 rounded-xl bg-zinc-900 border border-zinc-800">
          <div class="text-[11px] uppercase tracking-wider text-zinc-500 font-bold mb-2">Featured Outstream Video</div>
          <div class="aspect-video bg-black rounded-lg flex items-center justify-center text-zinc-600 text-xs">
            [Outstream Programmatic Video Unit Placeholder]
          </div>
        </div>
      </div>

      <!-- Bottom In-Content Ad -->
      <div class="my-8">
        <AdSlot slotKey="article_bottom_unit" minHeight="120px" />
      </div>

      <!-- Related Stories -->
      <div class="mt-8 pt-8 border-t border-zinc-800">
        <h3 class="text-lg font-bold text-white mb-4">Related Stories</h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {relatedArticles.slice(0, 4).map((item) => (
            <CardMedia post={item} variant="grid" />
          ))}
        </div>
      </div>
    </div>

    <!-- Sidebar Column (4 cols) -->
    <aside class="lg:col-span-4 flex flex-col gap-6">
      <div class="sticky top-20 flex flex-col gap-6">
        <AdSlot slotKey="article_sidebar_top" minHeight="250px" />

        <div class="bg-zinc-900/60 border border-zinc-800 rounded-2xl p-4">
          <h4 class="text-sm font-bold text-white mb-3">Popular in {post.category_name}</h4>
          <div class="flex flex-col gap-2">
            {relatedArticles.slice(0, 4).map((item) => (
              <CardMedia post={item} variant="compact" />
            ))}
          </div>
        </div>

        <AdSlot slotKey="article_sidebar_sticky" minHeight="600px" />
      </div>
    </aside>
  </article>
</Layout>
