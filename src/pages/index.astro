---
import Layout from '../layouts/Layout.astro';
import CardMedia from '../components/CardMedia.astro';
import AdSlot from '../components/AdSlot.astro';
import { getAllPosts, formatDuration } from '../lib/models';

const feedPosts = await getAllPosts(Astro.locals);
const heroPost = feedPosts.find((p) => p.is_featured) || feedPosts[0] || ({} as any);
const playlistPosts = feedPosts.filter((p) => p.id !== heroPost.id).slice(0, 4);
const trendingPosts = [...feedPosts].sort((a, b) => b.views_count - a.views_count);
---

<Layout title="Home - Video & Breaking News">
  <!-- 1. Hero Spotlight Section (2-Column Grid modeled on KGNow) -->
  <section class="grid grid-cols-1 lg:grid-cols-12 gap-6 mb-10">
    <!-- Left Hero (65% width approx -> 8 cols) -->
    <div class="lg:col-span-8 flex flex-col">
      <div class="relative w-full aspect-video rounded-2xl overflow-hidden bg-black group border border-zinc-800">
        <img
          src={heroPost.thumbnail_url}
          alt={heroPost.title}
          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/95 via-black/40 to-transparent flex flex-col justify-end p-6 sm:p-8">
          <div class="flex items-center gap-2 mb-3">
            <span class="bg-red-600 text-white font-extrabold text-[11px] uppercase tracking-wider px-2.5 py-1 rounded">
              {heroPost.category_name}
            </span>
            <span class="bg-black/60 backdrop-blur-md text-zinc-300 text-xs px-2.5 py-1 rounded font-mono">
              {formatDuration(heroPost.video_duration)}
            </span>
            <span class="text-xs text-zinc-400">Featured Spotlight</span>
          </div>
          <h2 class="text-xl sm:text-3xl font-extrabold text-white leading-tight group-hover:text-red-400 transition-colors">
            <a href={`/watch/${heroPost.slug}`}>{heroPost.title}</a>
          </h2>
          <p class="text-xs sm:text-sm text-zinc-300 mt-2 line-clamp-2 max-w-2xl font-normal leading-relaxed">
            {heroPost.excerpt}
          </p>
        </div>
        <a
          href={`/watch/${heroPost.slug}`}
          class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity bg-black/20"
        >
          <div class="w-16 h-16 rounded-full bg-red-600 text-white flex items-center justify-center shadow-2xl scale-90 group-hover:scale-100 transition-transform">
            <svg class="w-8 h-8 ml-1" fill="currentColor" viewBox="0 0 24 24">
              <path d="M8 5v14l11-7z" />
            </svg>
          </div>
        </a>
      </div>
    </div>

    <!-- Right Up Next / Editor's Picks (35% -> 4 cols) -->
    <div class="lg:col-span-4 flex flex-col bg-zinc-900/40 border border-zinc-800/80 rounded-2xl p-4">
      <div class="flex items-center justify-between pb-3 mb-2 border-b border-zinc-800">
        <h3 class="text-sm font-bold tracking-wide uppercase text-zinc-200 flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-red-500 animate-pulse"></span>
          Up Next / Editor's Pick
        </h3>
        <span class="text-[11px] text-zinc-500">Auto-queue</span>
      </div>
      <div class="flex flex-col gap-2 overflow-y-auto">
        {playlistPosts.map((post) => (
          <CardMedia post={post} variant="compact" />
        ))}
      </div>
    </div>
  </section>

  <!-- 2. Trending Horizontal Carousel ("Terpopuler") -->
  <section class="mb-12">
    <div class="flex items-center justify-between mb-4">
      <div class="flex items-center gap-2">
        <span class="w-3 h-6 bg-red-600 rounded-sm"></span>
        <h2 class="text-lg font-bold text-white tracking-tight">Terpopuler & Trending</h2>
      </div>
      <span class="text-xs text-zinc-400">Top viewed today</span>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
      {trendingPosts.slice(0, 4).map((post) => (
        <CardMedia post={post} variant="grid" />
      ))}
    </div>
  </section>

  <!-- 3. Category Feeds + Sticky Right Sidebar with Programmatic Ad -->
  <section class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-12">
    <!-- Main Feed (8 cols) -->
    <div class="lg:col-span-8 flex flex-col gap-6">
      <div class="flex items-center justify-between border-b border-zinc-800 pb-3">
        <h2 class="text-lg font-bold text-white">Latest Streams & Articles</h2>
        <span class="text-xs text-zinc-400">All updates</span>
      </div>

      <div class="flex flex-col gap-4">
        {feedPosts.map((post, idx) => (
          <>
            <CardMedia post={post} variant="horizontal" />
            {/* Native In-Feed Ad Unit injected every 3 items for high RPM */}
            {idx === 2 && (
              <div class="my-2">
                <AdSlot slotKey="in_feed_native" minHeight="120px" className="border-dashed" />
              </div>
            )}
          </>
        ))}
      </div>
    </div>

    <!-- Sticky Sidebar (4 cols) -->
    <aside class="lg:col-span-4 flex flex-col gap-6">
      <!-- Most Watched Ranked List -->
      <div class="bg-zinc-900/60 border border-zinc-800/80 rounded-2xl p-5">
        <h3 class="text-sm font-bold uppercase tracking-wider text-white mb-4 flex items-center gap-2">
          <span class="text-red-500 font-black">#</span> Most Watched
        </h3>
        <div class="flex flex-col divide-y divide-zinc-800/70">
          {trendingPosts.slice(0, 5).map((post, index) => (
            <a
              href={post.post_type === 'video' ? `/watch/${post.slug}` : `/read/${post.slug}`}
              class="group py-3 flex items-start gap-3 transition"
            >
              <span class={`text-lg font-black leading-none ${index === 0 ? 'text-red-500' : 'text-zinc-600'}`}>
                {index + 1}
              </span>
              <div class="flex flex-col">
                <h4 class="text-xs font-semibold text-zinc-200 group-hover:text-red-400 line-clamp-2 transition-colors">
                  {post.title}
                </h4>
                <span class="text-[10px] text-zinc-500 mt-1">
                  {post.category_name} • {post.views_count.toLocaleString()} views
                </span>
              </div>
            </a>
          ))}
        </div>
      </div>

      <!-- Sticky 300x600 Half-page Ad Slot -->
      <div class="sticky top-20">
        <AdSlot slotKey="sticky_sidebar" minHeight="600px" />
      </div>
    </aside>
  </section>
</Layout>
