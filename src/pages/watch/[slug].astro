---
import Layout from '../../layouts/Layout.astro';
import AdSlot from '../../components/AdSlot.astro';
import CardMedia from '../../components/CardMedia.astro';
import VideoPlayer from '../../components/VideoPlayer.astro';
import { getAllPosts, getPostBySlug, formatViews, formatDuration } from '../../lib/models';

const { slug } = Astro.params;
const allPosts = await getAllPosts(Astro.locals);
const post = (slug ? await getPostBySlug(slug, Astro.locals) : null) || allPosts.find((p) => p.post_type === 'video') || allPosts[0];
const relatedVideos = allPosts.filter((p) => p.id !== post.id && p.post_type === 'video');
const trendingPosts = [...allPosts].sort((a, b) => b.views_count - a.views_count).slice(0, 4);

// JSON-LD Structured Data for VideoObject (FR-04)
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "VideoObject",
  "name": post.title,
  "description": post.excerpt,
  "thumbnailUrl": [post.thumbnail_url],
  "uploadDate": post.published_at,
  "duration": `PT${post.video_duration || 0}S`,
  "contentUrl": post.video_url,
};
---

<Layout title={post.title} description={post.excerpt} currentCategory={post.category_slug}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
    <!-- Main Video & Content Column (8 cols) -->
    <div class="lg:col-span-8 flex flex-col">
      <!-- Theatrical Video.js + Google IMA Player Stage -->
      <VideoPlayer
        videoUrl={post.video_url || ''}
        posterUrl={post.thumbnail_url}
        playerId={`player-${post.id}`}
      />

      <!-- Metadata & Details -->
      <div class="mt-5 pb-6 border-b border-zinc-800">
        <div class="flex items-center gap-2 mb-2">
          <span class="bg-red-600 text-white font-bold text-xs uppercase px-2.5 py-0.5 rounded">
            {post.category_name}
          </span>
          <span class="text-xs text-zinc-400 font-mono">
            {formatDuration(post.video_duration)}
          </span>
          <span class="text-xs text-zinc-500">•</span>
          <span class="text-xs text-zinc-400">{formatViews(post.views_count)} views</span>
        </div>

        <h1 class="text-xl sm:text-2xl font-extrabold text-white leading-tight">
          {post.title}
        </h1>

        <!-- Author Bar -->
        <div class="flex items-center justify-between mt-4 pt-4 border-t border-zinc-800/80">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-zinc-800 border border-zinc-700 flex items-center justify-center font-bold text-sm text-red-500">
              {post.author_name?.[0] || 'E'}
            </div>
            <div>
              <p class="text-sm font-semibold text-zinc-200">{post.author_name}</p>
              <p class="text-xs text-zinc-500">Published on {new Date(post.published_at).toLocaleDateString()}</p>
            </div>
          </div>

          <!-- Share Actions -->
          <div class="flex items-center gap-2">
            <button class="px-3 py-1.5 rounded-lg bg-zinc-800 hover:bg-zinc-700 text-xs text-zinc-300 font-semibold transition">
              Share
            </button>
            <button class="px-3 py-1.5 rounded-lg bg-zinc-800 hover:bg-zinc-700 text-xs text-zinc-300 font-semibold transition">
              Save
            </button>
          </div>
        </div>

        <!-- Description Box -->
        <div class="mt-4 p-4 rounded-xl bg-zinc-900/60 border border-zinc-800/60 text-sm text-zinc-300 leading-relaxed">
          <p>{post.excerpt}</p>
          {post.content_html && (
            <div class="mt-3 prose prose-invert max-w-none text-xs text-zinc-400" set:html={post.content_html} />
          )}
        </div>
      </div>

      <!-- Mid Video Content Ad Slot -->
      <div class="my-6">
        <AdSlot slotKey="under_video_banner" minHeight="90px" />
      </div>

      <!-- Up Next Recommended Grid -->
      <div class="mt-4">
        <h3 class="text-base font-bold text-white mb-4">Recommended Videos</h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {relatedVideos.map((item) => (
            <CardMedia post={item} variant="grid" />
          ))}
        </div>
      </div>
    </div>

    <!-- Sidebar Column (4 cols) -->
    <aside class="lg:col-span-4 flex flex-col gap-6">
      <div class="sticky top-20 flex flex-col gap-6">
        <AdSlot slotKey="watch_sidebar_top" minHeight="250px" />

        <div class="bg-zinc-900/50 border border-zinc-800 rounded-2xl p-4">
          <h4 class="text-sm font-bold text-white mb-3">Trending Now</h4>
          <div class="flex flex-col gap-2">
            {trendingPosts.map((item) => (
              <CardMedia post={item} variant="compact" />
            ))}
          </div>
        </div>

        <AdSlot slotKey="watch_sidebar_sticky" minHeight="600px" />
      </div>
    </aside>
  </div>
</Layout>
