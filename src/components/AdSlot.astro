---
interface Props {
  slotKey: string;
  className?: string;
  minHeight?: string;
}

const { slotKey, className = '', minHeight = '90px' } = Astro.props;
---

<div
  class={`ad-slot-wrapper w-full flex items-center justify-center bg-zinc-900/60 border border-zinc-800/80 text-zinc-500 rounded text-xs select-none transition-opacity ${className}`}
  style={{ minHeight }}
  data-ad-slot={slotKey}
>
  <div class="flex flex-col items-center gap-1">
    <span class="text-[10px] tracking-wider uppercase text-zinc-500 font-medium">Advertisement</span>
    <span class="text-zinc-600 font-mono text-[11px]">[{slotKey}]</span>
  </div>
</div>

<script>
  // FR-02: IntersectionObserver lazy-loaded programmatic ad units
  const observer = new IntersectionObserver((entries, obs) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        const slotEl = entry.target as HTMLElement;
        const key = slotEl.dataset.adSlot;
        // Hook for programmatic ad tag initialization (e.g. GPT / Prebid / AdSense)
        slotEl.classList.add('ad-slot-loaded');
        obs.unobserve(slotEl);
      }
    });
  }, { rootMargin: '200px 0px' });

  document.querySelectorAll('.ad-slot-wrapper').forEach((slot) => {
    observer.observe(slot);
  });
</script>
