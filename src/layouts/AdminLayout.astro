---
import '../styles/global.css';

interface Props {
  title: string;
  activeTab?: 'dashboard' | 'posts' | 'uploader' | 'ads';
}

const { title, activeTab = 'dashboard' } = Astro.props;
const user = Astro.locals.user || { name: 'Editorial Lead', email: 'admin@themedia.local', role: 'admin' };
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | CMS Console</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="bg-zinc-950 text-zinc-100 min-h-screen flex antialiased selection:bg-red-600 selection:text-white">
    <!-- Sidebar Navigation -->
    <aside class="w-64 border-r border-zinc-800 bg-zinc-900/60 p-5 flex flex-col justify-between shrink-0 hidden md:flex">
      <div class="flex flex-col gap-6">
        <a href="/" class="flex items-center gap-2 group">
          <div class="w-8 h-8 rounded bg-red-600 flex items-center justify-center font-black text-white text-base shadow-md shadow-red-900/40">
            MP
          </div>
          <div class="flex flex-col">
            <span class="font-extrabold text-sm tracking-tight text-white leading-none">THEMEDIA</span>
            <span class="text-[9px] uppercase font-bold text-red-500 tracking-widest leading-tight">Admin Console</span>
          </div>
        </a>

        <nav class="flex flex-col gap-1 text-xs font-semibold text-zinc-400">
          <a
            href="/admin"
            class={`flex items-center gap-2.5 px-3 py-2 rounded-lg transition ${
              activeTab === 'dashboard' ? 'bg-zinc-800 text-white font-bold' : 'hover:bg-zinc-850 hover:text-white'
            }`}
          >
            <svg class="w-4 h-4 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
            </svg>
            Dashboard
          </a>

          <a
            href="/admin/posts"
            class={`flex items-center gap-2.5 px-3 py-2 rounded-lg transition ${
              activeTab === 'posts' ? 'bg-zinc-800 text-white font-bold' : 'hover:bg-zinc-850 hover:text-white'
            }`}
          >
            <svg class="w-4 h-4 text-zinc-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
            </svg>
            Posts & Video Menu
          </a>

          <a
            href="/admin/uploader"
            class={`flex items-center gap-2.5 px-3 py-2 rounded-lg transition ${
              activeTab === 'uploader' ? 'bg-zinc-800 text-white font-bold' : 'hover:bg-zinc-850 hover:text-white'
            }`}
          >
            <svg class="w-4 h-4 text-zinc-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
            </svg>
            Direct R2 Uploader
          </a>

          <a
            href="/admin/ads"
            class={`flex items-center gap-2.5 px-3 py-2 rounded-lg transition ${
              activeTab === 'ads' ? 'bg-zinc-800 text-white font-bold' : 'hover:bg-zinc-850 hover:text-white'
            }`}
          >
            <svg class="w-4 h-4 text-zinc-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
            </svg>
            AdSlot Config (D1)
          </a>
        </nav>
      </div>

      <!-- User footer + logout -->
      <div class="pt-4 border-t border-zinc-800 text-xs text-zinc-500 flex items-center justify-between">
        <div class="flex items-center gap-2.5 min-w-0">
          <div class="w-7 h-7 rounded-full bg-red-600 text-white font-bold flex items-center justify-center text-xs shrink-0">
            {user.name.charAt(0)}
          </div>
          <div class="flex flex-col min-w-0">
            <span class="text-zinc-200 font-semibold truncate">{user.name}</span>
            <span class="text-[10px] text-zinc-500 uppercase">{user.role}</span>
          </div>
        </div>

        <form method="POST" action="/api/admin/logout">
          <button type="submit" class="text-zinc-400 hover:text-red-400 font-medium transition cursor-pointer">
            Logout
          </button>
        </form>
      </div>
    </aside>

    <!-- Main Content Stage -->
    <main class="flex-1 flex flex-col min-w-0 overflow-y-auto">
      <header class="h-16 border-b border-zinc-800 bg-zinc-900/40 px-6 flex items-center justify-between sticky top-0 z-30 backdrop-blur-md">
        <div class="flex items-center gap-3">
          <a href="/admin" class="md:hidden w-7 h-7 rounded bg-red-600 flex items-center justify-center font-bold text-xs text-white">MP</a>
          <h1 class="text-base font-bold text-white">{title}</h1>
        </div>

        <div class="flex items-center gap-3">
          <a href="/" target="_blank" class="text-xs text-zinc-400 hover:text-white underline hidden sm:inline">
            Public Site ↗
          </a>
          <a
            href="/admin/posts/new"
            class="bg-red-600 hover:bg-red-700 text-white font-semibold text-xs px-3 py-1.5 rounded-lg shadow transition flex items-center gap-1.5"
          >
            <span>+ Create Post</span>
          </a>
        </div>
      </header>

      <div class="p-6 max-w-7xl w-full mx-auto space-y-6">
        <slot />
      </div>
    </main>
  </body>
</html>
